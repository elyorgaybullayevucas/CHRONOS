# ══════════════════════════════════════════════════════════════════════════════

# ── Datasetlar (og'ir fayllar, gitga kirmasin) ────────────────────────────────
data/ICEWS14/
data/ICEWS18/
data/WIKI/
data/YAGO/
data/YAGOs/
data/GDELT/
data/*.txt
data/*.tsv

# ── Checkpoint va model fayllar ───────────────────────────────────────────────
checkpoints/
*.pt
*.pth
*.ckpt

# ── Log fayllar ───────────────────────────────────────────────────────────────
logs/
*.log

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ── Virtual environment ───────────────────────────────────────────────────────
venv/
env/
.env
.envrc
.venv/
ENV/
env.bak/
venv.bak/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# ── Claude / AI assistant fayllar ────────────────────────────────────────────
.claude/
CLAUDE.md
tempCodeRunnerFile.py

# ── OS fayllar ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
profile_default/
ipython_config.py

# ── Test / coverage ───────────────────────────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
cover/

# ── Build / dist ──────────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.spec
*.manifest

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ── Package managers ──────────────────────────────────────────────────────────
.pdm-python
.pdm-build/
.pixi
__pypackages__/
pip-log.txt
pip-delete-this-directory.txt

# ── Misc ──────────────────────────────────────────────────────────────────────
